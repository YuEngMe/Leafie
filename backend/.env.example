APP_ENV=local
APP_NAME=Leafie API
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=leafie-media
MEDIA_DOWNLOAD_URL_EXPIRES_SECONDS=300
SUPABASE_QUEUE_NAME=leafie_jobs
ACCOUNT_DELETION_REAUTH_MAX_AGE_SECONDS=300
DATABASE_URL=

WORKER_POLL_INTERVAL_SECONDS=1
WORKER_VISIBILITY_TIMEOUT_SECONDS=60
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
WORKER_BATCH_SIZE=5

PLANTNET_API_KEY=
PLANTNET_BASE_URL=https://my-api.plantnet.org/v2
PLANTNET_PROJECT=all
PLANTNET_LANGUAGE=en
PLANTNET_RESULT_LIMIT=5
PLANTNET_TIMEOUT_SECONDS=20

KINDWISE_API_KEY=
KINDWISE_BASE_URL=https://api.plant.id/v3
KINDWISE_LANGUAGE=ko
KINDWISE_TIMEOUT_SECONDS=45

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_CHAT_MAX_OUTPUT_TOKENS=800
AI_CHAT_CONTEXT_MESSAGE_LIMIT=20
AI_CHAT_SUMMARY_TRIGGER_COUNT=30
AI_CHAT_SUMMARY_BATCH_SIZE=20
FCM_CREDENTIALS_JSON=
